---
import site from '../data/site.json';
const ordem = [4, 5, 6, 0, 1, 2, 3];
const fmt = (s) => { const [h, m] = s.split(':'); return m === '00' ? `${Number(h)}h` : `${Number(h)}h${m}`; };
const lista = ordem.map((d) => site.horarios.find((h) => h.dia === d));
---
<table class="horarios">
  <caption class="sr">Horários de funcionamento</caption>
  <tbody>
    {lista.map((h) => (
      <tr class={h.abre ? '' : 'fechado'}>
        <th scope="row">{h.nome}</th>
        <td>{h.abre ? `${fmt(h.abre)} às ${fmt(h.fecha)}` : 'Fechado'}</td>
      </tr>
    ))}
  </tbody>
</table>
